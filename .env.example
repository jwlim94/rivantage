# 이 파일을 .env로 복사한 뒤 실제 키를 넣으세요.
#   cp .env.example .env
# .env는 .gitignore에 들어 있어 커밋되지 않습니다.

# https://console.anthropic.com/settings/keys 에서 발급
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# search 단계를 Grok으로 돌릴 때만 필요 (--search-provider=grok)
# https://console.x.ai 에서 발급
XAI_API_KEY=

# 검색을 직접 조달할 때 필요 (--search-provider=serper)
# https://serper.dev — 가입 시 무료 크레딧 2,500 쿼리
SERPER_API_KEY=

# 2단계에서 Next.js + Supabase를 붙일 때 여기에 추가:
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
